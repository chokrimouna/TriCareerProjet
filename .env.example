# =====================================================================
# Modèle de configuration. COPIER ce fichier en ".env" et l'adapter :
#       cp .env.example .env        (Linux/Mac)
#       copy .env.example .env      (Windows cmd)
# Le fichier .env NE DOIT PAS être poussé sur Git (il est dans .gitignore).
# =====================================================================

# Identifiant de ton compte Docker Hub (sert à nommer et publier les images).
# Exemple : si ton username Docker Hub est "mounachokri", mets mounachokri.
DOCKERHUB_USER=ton_user_dockerhub

# Mot de passe du compte "sa" de SQL Server.
# Doit respecter la complexité SQL Server (maj + min + chiffre + symbole, 8+ car.)
SA_PASSWORD=YourStrong!Passw0rd

# Compte administrateur de Keycloak (console http://localhost:8080)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Clé API Groq pour l'analyse IA (forces/faiblesses, rapport — US12/US19/US20).
# Obtenir une clé gratuite sur https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Compte email utilisé pour les invitations test/entretien envoyées aux candidats.
# Compte Gmail (ou Google Workspace) + mot de passe d'application (pas le mot de passe normal).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=TriCareer
